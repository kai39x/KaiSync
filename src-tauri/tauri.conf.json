{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KaiSync",
  "version": "1.1.0",
  "identifier": "com.kaisync.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KaiSync",
        "width": 1080,
        "height": 680,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "KaiSync",
    "shortDescription": "Turns Windows HDR on for games and restores it afterwards",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Arabic",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "mainBinaryName": "KaiSync"
}
